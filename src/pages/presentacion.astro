---
import { getCollection } from 'astro:content';
import { CATEGORIES, matchCategory } from '../config/constants';

const allEditions = await getCollection('news');
allEditions.sort((a, b) => b.id.localeCompare(a.id));
const latestEdition = allEditions[0];

if (!latestEdition) {
  return Astro.redirect('/');
}

const { data } = latestEdition;

const categoriesOrder = CATEGORIES.map(c => c.id);
const newsByCategory = categoriesOrder.map(catId => 
    data.news.filter(n => matchCategory(n.category, catId))
);

const interleavedNews = [];
const maxItems = Math.max(...newsByCategory.map(list => list.length));

for (let i = 0; i < maxItems; i++) {
    for (const categoryList of newsByCategory) {
        if (categoryList[i]) {
            interleavedNews.push(categoryList[i]);
        }
    }
}
---
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>THE LOOP | Modo Presentación</title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;700&family=JetBrains+Mono:wght@400;700&display=swap');
        
        :root {
            --bg-color: #020617;
            --text-main: #f3f4f6;
            --text-muted: #9ca3af;
            --accent: #06b6d4;
            --accent-glow: rgba(6, 182, 212, 0.4);
            --font-title: 'Space Grotesk', sans-serif;
            --font-body: 'JetBrains Mono', monospace;
        }

        body, html {
            margin: 0; padding: 0; width: 100%; height: 100%;
            background-color: var(--bg-color);
            background-image: linear-gradient(rgba(6, 182, 212, 0.05) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(6, 182, 212, 0.05) 1px, transparent 1px);
            background-size: 40px 40px;
            color: var(--text-main);
            font-family: var(--font-body);
            overflow: hidden;
            cursor: pointer;
        }

        .slide {
            display: none;
            height: 100vh;
            width: 100vw;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding: 4rem;
            box-sizing: border-box;
            position: relative;
        }

        .slide.active { display: flex; animation: fadeIn 0.8s ease-out; }
        @keyframes fadeIn { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }
        
        /* Intro/Outro Slide */
        .intro-title { 
            font-family: var(--font-title);
            font-size: 10rem; 
            font-weight: 700; 
            color: #fff;
            margin: 0;
            letter-spacing: -4px;
            text-shadow: 0 0 20px var(--accent-glow), 0 0 40px rgba(139, 92, 246, 0.3);
            text-transform: uppercase;
        }
        .intro-badge {
            font-family: var(--font-title);
            font-size: 1.3rem;
            font-weight: 700;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: var(--accent);
            border: 2px solid var(--accent);
            border-radius: 100px;
            padding: 0.5rem 1.75rem;
            margin-bottom: 2rem;
            text-shadow: 0 0 10px var(--accent-glow);
            box-shadow: 0 0 20px var(--accent-glow);
        }
        .intro-slogan {
            font-size: 1.5rem; 
            color: var(--accent); 
            margin-top: 1rem; 
            max-width: 800px; 
            line-height: 1.4;
            letter-spacing: 2px;
            text-transform: uppercase;
        }

        /* News Title Slide */
        .category { 
            font-family: var(--font-title);
            text-transform: uppercase; 
            font-weight: 700; 
            font-size: 1.5rem; 
            letter-spacing: 8px; 
            margin-bottom: 2rem;
            text-shadow: 0 0 10px currentColor;
        }
        .title { 
            font-family: var(--font-title);
            font-size: 6rem; 
            line-height: 1; 
            margin-bottom: 2rem; 
            max-width: 90%; 
            font-weight: 700;
            color: #fff;
        }
        .summary { 
            font-size: 1.8rem; 
            color: var(--text-muted); 
            max-width: 70%; 
            line-height: 1.5; 
        }

        /* News Detail Slide */
        .detail-container { 
            display: flex; 
            width: 100%; 
            height: 100%; 
            align-items: center; 
            gap: 5rem; 
            padding: 2rem; 
        }
        .detail-image { 
            flex: 1; 
            height: 70vh; 
            border: 1px solid rgba(6, 182, 212, 0.3);
            border-radius: 4px; 
            overflow: hidden; 
            box-shadow: 0 0 30px rgba(6, 182, 212, 0.15); 
            background: rgba(15, 23, 42, 0.8);
        }
        .detail-image img { 
            width: 100%; 
            height: 100%; 
            object-fit: cover;
            opacity: 0.9;
            filter: saturate(0.8) contrast(1.1);
        }
        .detail-text { flex: 1.2; text-align: left; }
        .detail-text .category { margin-bottom: 1.5rem; font-size: 1.2rem; }
        .detail-context { font-size: 1.4rem; line-height: 1.6; color: var(--text-main); margin-bottom: 2.5rem; }
        .detail-bullets { list-style: none; padding: 0; }
        .detail-bullets li { 
            font-size: 1.2rem; 
            margin-bottom: 1.2rem; 
            position: relative; 
            padding-left: 2.5rem; 
            color: var(--text-main); 
        }
        .detail-bullets li::before { 
            content: ">"; 
            position: absolute; 
            left: 0; 
            color: var(--accent); 
            font-weight: bold;
            text-shadow: 0 0 8px var(--accent);
        }

        .progress-container { position: absolute; bottom: 0; left: 0; width: 100%; height: 6px; background: rgba(15, 23, 42, 0.5); }
        .progress-bar { height: 100%; background: var(--accent); width: 0%; box-shadow: 0 0 10px var(--accent); }
        .footer { 
            position: absolute; 
            bottom: 40px; 
            right: 40px; 
            font-size: 1rem; 
            color: var(--accent); 
            font-weight: bold;
            letter-spacing: 2px;
            background: rgba(15, 23, 42, 0.8);
            padding: 0.5rem 1rem;
            border: 1px solid rgba(6, 182, 212, 0.3);
        }
        
        #fullscreen-btn, #grid-btn {
            position: fixed; top: 20px; right: 20px;
            background: rgba(6, 182, 212, 0.1); border: 1px solid rgba(6, 182, 212, 0.3);
            color: var(--accent); padding: 8px 16px; border-radius: 4px;
            cursor: pointer; z-index: 1000; font-weight: bold; 
            font-family: var(--font-body);
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s;
        }
        #grid-btn { top: 64px; }
        #fullscreen-btn:hover, #grid-btn:hover {
            background: rgba(6, 182, 212, 0.2);
            box-shadow: 0 0 15px var(--accent-glow);
        }
        .fullscreen-hidden #fullscreen-btn, .fullscreen-hidden #grid-btn { opacity: 0; }

        .qr-code { height: 30vh; width: auto; margin-top: 3rem; border-radius: 8px; box-shadow: 0 0 30px var(--accent-glow); }
        .rotate-hint { display: none; }

        /* Celular: cada slide se dibuja como en una pantalla de 1280x720 y se
           escala al ancho del teléfono, con franjas negras arriba y abajo */
        body.phone { background: #000; }
        body.phone #slides-container {
            position: fixed; top: 50%; left: 50%;
            width: 1280px; height: 720px;
            transform: translate(-50%, -50%) scale(var(--frame-scale));
            overflow: hidden;
            background-color: var(--bg-color);
            background-image: linear-gradient(rgba(6, 182, 212, 0.05) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(6, 182, 212, 0.05) 1px, transparent 1px);
            background-size: 40px 40px;
        }
        body.phone .slide { width: 100%; height: 100%; }
        body.phone .detail-container { gap: 3rem; }
        body.phone .detail-image { flex: 0.75; height: 504px; }
        body.phone .detail-text .category { font-size: 1.6rem; }
        body.phone .detail-context { font-size: 1.9rem; line-height: 1.45; margin-bottom: 1.5rem; }
        body.phone .detail-bullets li { font-size: 1.9rem; line-height: 1.35; margin-bottom: 1rem; }
        body.phone .summary { font-size: 2.6rem; max-width: 85%; }
        body.phone .qr-code { height: 216px; }
        body.phone #fullscreen-btn, body.phone:not(.grid-mode) #grid-btn { display: none; }
        body.phone .progress-container { position: fixed; top: calc(50% + var(--frame-h) / 2); bottom: auto; }
        @media (orientation: portrait) {
            body.phone .rotate-hint {
                display: block;
                position: fixed; left: 0; width: 100%;
                top: calc(50% + var(--frame-h) / 2 + 24px);
                text-align: center;
                font-size: 0.8rem;
                letter-spacing: 1px;
                color: var(--text-muted);
            }
            body.phone:not(.grid-mode) #grid-btn {
                display: block;
                top: calc(50% + var(--frame-h) / 2 + 64px);
                left: 50%; right: auto;
                transform: translateX(-50%);
            }
        }

        /* Vista de grilla: todas las slides juntas para revisar */
        :global(.thumb) { display: contents; }
        :global(.thumb-label) { display: none; }
        body.grid-mode { overflow-y: auto; cursor: default; }
        body.grid-mode #fullscreen-btn { display: none; }
        body.grid-mode #grid-btn { top: 20px; }
        body.grid-mode .progress-container { display: none; }
        body.grid-mode #slides-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 24px;
            padding: 72px 24px 24px;
        }
        body.grid-mode :global(.thumb) {
            display: block;
            position: relative;
            overflow: hidden;
            aspect-ratio: var(--vw) / var(--vh);
            border: 1px solid rgba(6, 182, 212, 0.3);
            cursor: pointer;
        }
        body.grid-mode :global(.thumb.current) { border-color: var(--accent); box-shadow: 0 0 15px var(--accent-glow); }
        body.grid-mode :global(.thumb:hover) { border-color: var(--accent); }
        body.grid-mode .slide {
            display: flex;
            position: absolute; top: 0; left: 0;
            transform: scale(var(--thumb-scale));
            transform-origin: 0 0;
            animation: none;
            pointer-events: none;
        }
        body.grid-mode :global(.thumb-label) {
            display: block;
            position: absolute; top: 8px; left: 8px; z-index: 1;
            font-size: 0.8rem; font-weight: bold;
            color: var(--accent);
            background: rgba(15, 23, 42, 0.85);
            padding: 2px 8px;
        }

        /* Grilla en celular: una slide abajo de la otra, al ancho del teléfono */
        body.phone.grid-mode #slides-container {
            position: static;
            width: auto; height: auto;
            transform: none;
            overflow: visible;
            background: none;
            grid-template-columns: 1fr;
            gap: 12px;
            padding: 64px 0 16px;
        }
        body.phone.grid-mode :global(.thumb) {
            background-color: var(--bg-color);
            background-image: linear-gradient(rgba(6, 182, 212, 0.05) 1px, transparent 1px),
                              linear-gradient(90deg, rgba(6, 182, 212, 0.05) 1px, transparent 1px);
            background-size: 12px 12px;
        }
        body.phone.grid-mode .slide { width: 1280px; height: 720px; }
        body.phone.grid-mode #grid-btn { top: 12px; right: 12px; }
        body.phone.grid-mode .rotate-hint { display: none; }
    </style>
</head>
<body>
    <button id="fullscreen-btn">PANTALLA COMPLETA</button>
    <button id="grid-btn">VER TODAS</button>
    
    <div id="slides-container">
        <!-- Portada Inicial -->
        <div class="slide active" data-duration="15000">
            {data.intro_label && <div class="intro-badge">{data.intro_label} &middot; {data.funny_title}</div>}
            <h1 class="intro-title">THE LOOP</h1>
            <p class="intro-slogan">Noticias que importan, explicadas para que formes tu propia opinión.</p>
            <div class="footer">EDICIÓN {data.date}</div>
        </div>

        {interleavedNews.map((item) => {
            const categoryObj = CATEGORIES.find(c => matchCategory(c.id, item.category));
            const categoryLabel = categoryObj ? categoryObj.label : item.category;
            const categoryColor = categoryObj ? categoryObj.color : "#3b82f6";

            return (
                <>
                    <!-- Slide A: Título -->
                    <div class="slide" data-color={categoryColor} data-duration="8000">
                        <div class="category" style={`color: ${categoryColor}`}>{categoryLabel}</div>
                        <div class="title" style={`color: white`}>{item.presentation_title || item.title}</div>
                        <div class="summary">{item.short_summary}</div>
                        <div class="footer">THE LOOP | {data.date}</div>
                    </div>
                    <!-- Slide B: Detalle -->
                    <div class="slide" data-color={categoryColor} data-duration="12000">
                        <div class="detail-container">
                            <div class="detail-image">
                                <img src={item.image} alt={item.title} onerror="this.src='https://images.unsplash.com/photo-1504711434969-e33886168f5c?auto=format&fit=crop&w=1200&q=80'" />
                            </div>
                            <div class="detail-text">
                                <div class="category" style={`color: ${categoryColor}`}>{categoryLabel}</div>
                                <div class="detail-text-content">
                                    <div class="detail-context">
                                        {item.context.split('\n').map((line) => {
                                            if (!line.trim().startsWith('*') && line.trim() !== "") {
                                                const parts = line.split(/(\*\*.*?\*\*)/g);
                                                return <p>{parts.map(part => {
                                                    if (part.startsWith('**') && part.endsWith('**')) {
                                                        return <strong style="color: white; font-weight: 800;">{part.slice(2, -2)}</strong>;
                                                    }
                                                    return part;
                                                })}</p>;
                                            }
                                            return null;
                                        })}
                                    </div>
                                    <ul class="detail-bullets">
                                        {item.context.split('\n').map((line) => {
                                            if (line.trim().startsWith('*')) {
                                                const cleanText = line.trim().substring(1).trim();
                                                const parts = cleanText.split(/(\*\*.*?\*\*)/g);
                                                return <li>{parts.map(part => {
                                                    if (part.startsWith('**') && part.endsWith('**')) {
                                                        return <strong style="color: white; font-weight: 800;">{part.slice(2, -2)}</strong>;
                                                    }
                                                    return part;
                                                })}</li>;
                                            }
                                            return null;
                                        })}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </>
            );
        })}

        <!-- Slide Final -->
        <div class="slide" data-duration="10000">
            <p style="font-size: 2.5rem; color: #94a3b8; margin-bottom: 1rem; font-weight: 700; text-align: center;">Conocé más en:</p>
            <p style="font-size: 5rem; color: white; font-weight: 900; letter-spacing: -2px; margin: 0; white-space: nowrap; text-align: center; width: 100%;">the-weekly-loop.vercel.app</p>
            <img src="/qr-websitehome.jpeg" alt="QR a the-weekly-loop.vercel.app" class="qr-code" />
        </div>
    </div>
    
    <div class="rotate-hint">Girá el celular para leer mejor ⟳</div>

    <div class="progress-container">
        <div class="progress-bar" id="progress"></div>
    </div>

    <script>
        const slides = document.querySelectorAll('.slide');
        const progressBar = document.getElementById('progress');
        const fullscreenBtn = document.getElementById('fullscreen-btn');
        const gridBtn = document.getElementById('grid-btn');
        const container = document.getElementById('slides-container');
        let currentSlide = 0;
        let start = Date.now();
        let gridMode = false;

        // Cada slide va dentro de un .thumb (display: contents fuera de la grilla)
        const thumbs = Array.from(slides).map((slide, i) => {
            const thumb = document.createElement('div');
            thumb.className = 'thumb';
            slide.before(thumb);
            thumb.appendChild(slide);
            const label = document.createElement('div');
            label.className = 'thumb-label';
            label.textContent = `${i + 1} / ${slides.length}`;
            thumb.appendChild(label);
            thumb.onclick = (e) => {
                // Fuera de la grilla el click sigue de largo (pantalla completa)
                if (!gridMode) return;
                e.stopPropagation();
                showSlide(i);
                toggleGrid();
            };
            return thumb;
        });

        function getDuration() {
            return parseInt(slides[currentSlide].getAttribute('data-duration') || "15000");
        }

        function update() {
            if (!gridMode) {
                const duration = getDuration();
                const elapsed = Date.now() - start;
                const progress = (elapsed / duration) * 100;

                if (progress >= 100) {
                    showSlide(currentSlide + 1);
                } else {
                    progressBar.style.width = progress + '%';
                }
            }
            requestAnimationFrame(update);
        }

        function showSlide(index) {
            slides[currentSlide].classList.remove('active');
            thumbs[currentSlide].classList.remove('current');
            currentSlide = (index + slides.length) % slides.length;
            slides[currentSlide].classList.add('active');
            thumbs[currentSlide].classList.add('current');

            const nextColor = slides[currentSlide].getAttribute('data-color') || "#3b82f6";
            progressBar.style.backgroundColor = nextColor;
            progressBar.style.width = '0%';

            start = Date.now();
        }

        function updateThumbScale() {
            // En celular las slides miden 1280x720; en compu, lo que mide la ventana
            const isPhone = document.body.classList.contains('phone');
            const baseW = isPhone ? 1280 : window.innerWidth;
            const baseH = isPhone ? 720 : window.innerHeight;
            container.style.setProperty('--vw', baseW);
            container.style.setProperty('--vh', baseH);
            if (gridMode && thumbs[0]) {
                container.style.setProperty('--thumb-scale', thumbs[0].clientWidth / baseW);
            }
        }

        function toggleGrid() {
            gridMode = !gridMode;
            document.body.classList.toggle('grid-mode', gridMode);
            gridBtn.textContent = gridMode ? 'VOLVER AL LOOP' : 'VER TODAS';
            if (gridMode) {
                updateThumbScale();
                thumbs[currentSlide].scrollIntoView({ block: 'center' });
            } else {
                document.body.scrollTop = 0;
                start = Date.now();
            }
        }

        window.addEventListener('resize', updateThumbScale);

        const phoneQuery = window.matchMedia('(max-width: 600px), (max-height: 500px) and (pointer: coarse)');

        function applyPhoneLayout() {
            const isPhone = phoneQuery.matches;
            const wasPhone = document.body.classList.contains('phone');
            if (isPhone !== wasPhone && gridMode) toggleGrid();
            document.body.classList.toggle('phone', isPhone);
            if (isPhone) {
                const scale = Math.min(window.innerWidth / 1280, window.innerHeight / 720);
                document.body.style.setProperty('--frame-scale', scale);
                document.body.style.setProperty('--frame-h', `${720 * scale}px`);
            }
            updateThumbScale();
        }

        applyPhoneLayout();
        window.addEventListener('resize', applyPhoneLayout);
        phoneQuery.addEventListener('change', applyPhoneLayout);

        document.addEventListener('keydown', (e) => {
            if (gridMode) {
                if (e.key === 'Escape') toggleGrid();
                return;
            }
            if (e.key === 'ArrowRight') showSlide(currentSlide + 1);
            else if (e.key === 'ArrowLeft') showSlide(currentSlide - 1);
        });

        thumbs[0].classList.add('current');
        progressBar.style.backgroundColor = slides[0].getAttribute('data-color') || "#3b82f6";
        requestAnimationFrame(update);

        gridBtn.onclick = (e) => { e.stopPropagation(); toggleGrid(); };

        function toggleFullscreen() {
            if (!document.documentElement.requestFullscreen) return; // iPhone no lo soporta
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen();
                document.body.classList.add('fullscreen-hidden');
            } else {
                document.exitFullscreen();
                document.body.classList.remove('fullscreen-hidden');
            }
        }

        fullscreenBtn.onclick = (e) => { e.stopPropagation(); toggleFullscreen(); };
        document.body.onclick = () => { if (!gridMode && !document.fullscreenElement) toggleFullscreen(); };
    </script>
</body>
</html>
