---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, CATEGORIES } from '../config/constants';

const sectionDescriptions: Record<string, string> = {
    'geopolítica': 'Conflictos, elecciones, acuerdos y decisiones que cambian el mapa del mundo.',
    'nacional': 'Lo que pasa en Argentina: economía, leyes, política y sociedad.',
    'ciencia-ambiente': 'Descubrimientos, salud, clima y el cuidado del planeta.',
    'negocios-tecnologia': 'Empresas, inteligencia artificial y la tecnología que usamos todos los días.',
    'opinión': 'Miradas y debates, presentados siempre como opiniones y no como hechos.',
};
---

<Layout title={`${SITE_TITLE} | Proyecto`}>
    <header class="project-header">
        <h1>Proyecto</h1>
        <p class="lead">Noticias que importan, explicadas para que formes tu propia opinión.</p>
    </header>

    <section class="block">
        <h2>¿Qué es The Loop?</h2>
        <p>
            The Loop es un resumen semanal de noticias pensado para estudiantes. Su objetivo es acercar
            lo que pasa en el mundo y en Argentina a un público adolescente, con textos claros, contexto
            suficiente para entender cada tema y las fuentes a mano para profundizar.
        </p>
        <p>
            Funciona en dos formatos que se complementan: una presentación que se proyecta en loop en las
            pantallas de los espacios comunes de la escuela, y este sitio web, donde cada noticia se puede
            leer completa.
        </p>
    </section>

    <section class="block">
        <h2>Fuentes</h2>
        <p>
            Las fuentes son la parte principal y, en definitiva, la más esencial del proyecto: ninguna
            de las noticias se presenta sin una variedad de fuentes de todo el espectro político. El eslogan
            del proyecto es "Noticias que importan, explicadas para que formes tu propia opinión" porque se
            busca que, a partir de la lectura de las fuentes y del contexto provisto, los estudiantes decidan
            qué pensar sobre la noticia y <strong>formen su propia opinión</strong>.
        </p>
    </section>

    <section class="block">
        <h2>Secciones</h2>
        <div class="sections-grid">
            {CATEGORIES.map(cat => (
                <div class="section-card" style={`--cat-color: ${cat.color}`}>
                    <h3>{cat.label}</h3>
                    <p>{sectionDescriptions[cat.id]}</p>
                </div>
            ))}
        </div>
    </section>

    <section class="block">
        <h2>Dónde encontrarlo</h2>
        <ul class="places">
            <li>
                <a href="/presentacion" target="_blank"><strong>El loop</strong></a>: la presentación que se
                ve en las pantallas. Cada noticia tiene una pantalla con el titular y otra con los puntos clave.
            </li>
            <li>
                <a href="/ultima"><strong>Última edición</strong></a>: las noticias de la semana, con el
                desarrollo completo y las fuentes para contrastar.
            </li>
            <li>
                <a href="/archivo"><strong>Archivo</strong></a>: todas las ediciones anteriores.
            </li>
            <li>
                <a href="/mas-informacion"><strong>Glosario</strong></a>: explicaciones de términos, lugares,
                personas y conceptos que aparecen en las noticias. Cada entrada se arma con al menos tres
                fuentes confiables (medios, organismos oficiales, universidades o centros de investigación).
            </li>
        </ul>
    </section>
</Layout>

<style>
    .project-header {
        text-align: center;
        margin-bottom: 3rem;
        padding-top: 2rem;
    }

    .project-header h1 {
        font-size: 3rem;
        margin-bottom: 1rem;
        font-weight: 900;
    }

    .lead {
        color: #94a3b8;
        font-size: 1.1rem;
        max-width: 600px;
        margin: 0 auto;
    }

    .block {
        max-width: 760px;
        margin: 0 auto 3rem;
    }

    .block h2 {
        color: var(--accent);
        text-transform: uppercase;
        letter-spacing: 2px;
        font-size: 1.1rem;
        border-bottom: 2px solid #1e293b;
        padding-bottom: 0.5rem;
        margin: 0 0 1.25rem;
    }

    .block p {
        line-height: 1.7;
        color: #e2e8f0;
        margin: 0 0 1rem;
    }

    .sections-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 1rem;
    }

    .section-card {
        background: #1e293b;
        border: 1px solid #334155;
        border-left: 6px solid var(--cat-color);
        border-radius: 0.75rem;
        padding: 1.1rem 1.25rem;
    }

    .section-card h3 {
        margin: 0 0 0.4rem;
        color: var(--cat-color);
        font-size: 0.95rem;
        letter-spacing: 1px;
    }

    .section-card p {
        margin: 0;
        font-size: 0.9rem;
        line-height: 1.5;
        color: #cbd5e1;
    }

    .places {
        padding-left: 1.25rem;
        margin: 0;
        line-height: 1.7;
        color: #e2e8f0;
    }

    .places li {
        margin-bottom: 0.75rem;
    }

    .places a {
        color: #93c5fd;
        text-decoration: none;
    }

    .places a:hover {
        color: #fff;
    }

    @media (max-width: 600px) {
        .project-header {
            margin-bottom: 2rem;
            padding-top: 0.5rem;
        }
        .project-header h1 {
            font-size: 2.4rem;
        }
        .block {
            margin-bottom: 2.25rem;
        }
        .block p, .places {
            font-size: 0.95rem;
        }
    }
</style>
